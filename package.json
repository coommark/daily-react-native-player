{
  "name": "daily-react-native-player",
  "version": "0.1.0",
  "description": "Expo-first background audio for React Native (New Architecture only). Lock-screen & notification remotes, now-playing metadata, speech queue, WAV/mp3/m4a + HLS, native silence tracks, optional ambient dual-audio. MIT. Built for Daily Bible.",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    },
    "./app.plugin": "./app.plugin.js",
    "./app.plugin.js": "./app.plugin.js"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "files": [
    "build",
    "android",
    "ios",
    "expo-module.config.json",
    "app.plugin.js",
    "plugin/build",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node internal/module_scripts/build.js",
    "clean": "node internal/module_scripts/clean.js",
    "lint": "eslint src/ plugin/src/",
    "test": "CI=1 node internal/module_scripts/test.js",
    "test:watch": "node internal/module_scripts/test.js",
    "typecheck": "tsc --noEmit",
    "pack:check": "node internal/module_scripts/pack-check.js",
    "assert:prebuild": "node internal/module_scripts/assert-prebuild.js",
    "prepare": "node internal/module_scripts/prepare.js",
    "open:ios": "node internal/module_scripts/open-ios.js",
    "open:android": "node internal/module_scripts/open-android.js"
  },
  "keywords": [
    "react-native",
    "expo",
    "expo-module",
    "audio",
    "player",
    "background-audio",
    "background-playback",
    "lock-screen",
    "notification",
    "now-playing",
    "media-session",
    "mediasession",
    "queue",
    "hls",
    "mp3",
    "m4a",
    "wav",
    "streaming",
    "silence",
    "ambient",
    "dual-audio",
    "speech",
    "narration",
    "podcast",
    "bible",
    "daily-bible",
    "new-architecture",
    "mit",
    "DailyReactNativePlayer"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coommark/daily-react-native-player.git"
  },
  "bugs": {
    "url": "https://github.com/coommark/daily-react-native-player/issues"
  },
  "author": "Mark Melton <coommark@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/coommark/daily-react-native-player#readme",
  "dependencies": {},
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/jest": "^29.2.1",
    "@types/react": "~19.1.1",
    "babel-preset-expo": "~55.0.8",
    "eslint": "~9.39.4",
    "eslint-config-universe": "^15.0.3",
    "expo": "^57.0.9",
    "jest": "^29.7.0",
    "jest-expo": "~55.0.9",
    "prettier": "^3.0.0",
    "react": "19.1.1",
    "react-native": "0.82.1",
    "typescript": "^5.9.2"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.js",
      "**/__tests__/**/*.test.ts"
    ]
  },
  "peerDependencies": {
    "expo": ">=53.0.0",
    "react": "*",
    "react-native": ">=0.79.0"
  },
  "peerDependenciesMeta": {
    "expo": {
      "optional": true
    }
  }
}
