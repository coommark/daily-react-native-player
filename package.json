{
  "name": "daily-react-native-player",
  "version": "0.1.0",
  "description": "Expo-first background audio player for React Native (New Architecture), built primarily for Daily Bible - Offline & Audio. Queue, HLS, lock-screen controls, silence tracks, and optional ambient dual-audio.",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "scripts": {
    "build": "node internal/module_scripts/build.js",
    "clean": "node internal/module_scripts/clean.js",
    "lint": "eslint src/",
    "test": "CI=1 node internal/module_scripts/test.js",
    "test:watch": "node internal/module_scripts/test.js",
    "typecheck": "tsc --noEmit",
    "prepare": "node internal/module_scripts/prepare.js",
    "open:ios": "node internal/module_scripts/open-ios.js",
    "open:android": "node internal/module_scripts/open-android.js"
  },
  "keywords": [
    "react-native",
    "expo",
    "audio",
    "player",
    "background-audio",
    "media-session",
    "hls",
    "daily-bible",
    "DailyReactNativePlayer"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coommark/daily-react-native-player.git"
  },
  "bugs": {
    "url": "https://github.com/coommark/daily-react-native-player/issues"
  },
  "author": "Mark Melton <coommark@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/coommark/daily-react-native-player#readme",
  "dependencies": {},
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/jest": "^29.2.1",
    "@types/react": "~19.1.1",
    "babel-preset-expo": "~55.0.8",
    "eslint": "~9.39.4",
    "eslint-config-universe": "^15.0.3",
    "expo": "^57.0.9",
    "jest": "^29.7.0",
    "jest-expo": "~55.0.9",
    "prettier": "^3.0.0",
    "react": "19.1.1",
    "react-native": "0.82.1",
    "typescript": "^5.9.2"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.js",
      "**/__tests__/**/*.test.ts"
    ]
  },
  "peerDependencies": {
    "expo": "*",
    "react": "*",
    "react-native": "*"
  }
}
