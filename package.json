{
  "name": "daily-react-native-player",
  "version": "0.1.0",
  "description": "Edge-native Expo background audio — TTS playlists, music queues, lock screen, HLS, silence tracks, ambient dual-audio. MIT. Built for Daily Bible.",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "files": [
    "build",
    "!build/**/*.map",
    "android/src",
    "android/build.gradle",
    "android/consumer-rules.pro",
    "ios",
    "expo-module.config.json",
    "app.plugin.js",
    "plugin/build",
    "!plugin/build/**/*.map",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node internal/module_scripts/build.js",
    "clean": "node internal/module_scripts/clean.js",
    "lint": "eslint src/ plugin/src/",
    "test": "CI=1 node internal/module_scripts/test.js",
    "test:watch": "node internal/module_scripts/test.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p plugin/tsconfig.json",
    "pack:check": "node internal/module_scripts/pack-check.js",
    "assert:prebuild": "node internal/module_scripts/assert-prebuild.js",
    "prepare": "node internal/module_scripts/prepare.js",
    "prepublishOnly": "yarn build && yarn pack:check",
    "open:ios": "node internal/module_scripts/open-ios.js",
    "open:android": "node internal/module_scripts/open-android.js"
  },
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "react-native": "./build/index.js",
      "default": "./build/index.js"
    },
    "./app.plugin": "./app.plugin.js",
    "./app.plugin.js": "./app.plugin.js"
  },
  "sideEffects": [
    "./build/DailyReactNativePlayerModule.js",
    "./build/DailyReactNativePlayerModule.web.js"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "keywords": [
    "react-native",
    "expo",
    "expo-module",
    "tts",
    "text-to-speech",
    "edge-native",
    "on-device",
    "audio",
    "player",
    "playlist",
    "music-player",
    "background-audio",
    "background-playback",
    "lock-screen",
    "notification",
    "now-playing",
    "media-session",
    "mediasession",
    "queue",
    "hls",
    "mp3",
    "m4a",
    "wav",
    "streaming",
    "silence",
    "ambient",
    "dual-audio",
    "speech",
    "narration",
    "audiobook",
    "podcast",
    "bible",
    "daily-bible",
    "new-architecture",
    "mit",
    "DailyReactNativePlayer"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coommark/daily-react-native-player.git"
  },
  "bugs": {
    "url": "https://github.com/coommark/daily-react-native-player/issues"
  },
  "author": "Mark Melton <coommark@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/coommark/daily-react-native-player#readme",
  "dependencies": {},
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/jest": "^29.2.1",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~57.0.5",
    "eslint": "~9.39.4",
    "eslint-config-universe": "^15.0.3",
    "expo": "^57.0.9",
    "jest": "^29.7.0",
    "prettier": "^3.0.0",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "typescript": "^5.9.2"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.js",
      "**/__tests__/**/*.test.ts"
    ],
    "transform": {
      "^.+\\.[jt]sx?$": "babel-jest"
    },
    "moduleNameMapper": {
      "^react-native$": "<rootDir>/src/__mocks__/react-native.js"
    }
  },
  "peerDependencies": {
    "expo": ">=57.0.0",
    "react": "*",
    "react-native": ">=0.86.0"
  }
}
