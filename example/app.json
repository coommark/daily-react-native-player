{
  "expo": {
    "name": "Daily React Native Player Example",
    "slug": "daily-react-native-player-example",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "expo.modules.dailyreactnativeplayer.example"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "expo.modules.dailyreactnativeplayer.example"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": ["daily-react-native-player"]
  }
}